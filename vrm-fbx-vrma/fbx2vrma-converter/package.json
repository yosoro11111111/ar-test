    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "fbx",
    "vrma",
    "vrm",
    "animation",
    "mixamo",
    "three-vrm",
    "gltf",
    "converter",
    "vr",
    "avatar",
    "nodejs",
    "javascript",
    "webgl",
    "threejs"
  ],
  "author": "TK-256",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/TK-256/fbx2vrma-converter.git"
  },
  "bugs": {
    "url": "https://github.com/TK-256/fbx2vrma-converter/issues"
  },
  "homepage": "https://github.com/TK-256/fbx2vrma-converter#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@pixiv/three-vrm-animation": "^3.0.0",
    "commander": "^11.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fs-extra": "^11.2.0",
    "jszip": "^3.10.1",
